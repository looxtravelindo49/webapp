# Database. Pilih salah satu:
# 1) Berkas SQLite lokal (pengembangan, server/kontainer). Di container: /data/app.db (pasang volume di /data).
DATABASE_PATH=./data/app.db
# 2) Turso (wajib di Vercel). DATABASE_URL mengalahkan DATABASE_PATH.
# DATABASE_URL=libsql://<nama>.turso.io
# DATABASE_AUTH_TOKEN=

# Foto unggahan di Vercel Blob (store privat). Wajib di Vercel; bila kosong, foto disimpan di UPLOAD_DIR.
# BLOB_READ_WRITE_TOKEN=

# Saat build di Vercel: wilayah fungsi (dipisah koma), samakan dengan wilayah Turso, mis. sin1.
# VERCEL_REGIONS=

# Alamat publik situs, dipakai untuk canonical, Open Graph, sitemap, dan robots.
PUBLIC_SITE_URL=https://lembangadventure.com

# Di balik reverse proxy HTTPS (adapter-node 6 tidak lagi membaca ORIGIN): protokol dianggap https dan host
# diambil dari header Host. Bila proxy memakai header lain, setel nama headernya di sini.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# PORT=3000

# Akun admin awal, dibuat hanya bila tabel user kosong (wajib ganti password saat login pertama).
# Bawaan: admin@looxtravel / 12345678. Jangan buka situs ke publik sebelum password diganti.
# ADMIN_SEED_LOGIN=admin@looxtravel
# ADMIN_SEED_PASSWORD=12345678

# Pemulihan akun: atur ulang password satu akun saat start. HAPUS setelah dipakai.
# ADMIN_RESET_LOGIN=
# ADMIN_RESET_PASSWORD=

# Di balik reverse proxy (untuk IP klien pada pembatasan login):
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Foto paket yang diunggah admin. Bawaan: folder `uploads` di samping berkas database
# (di kontainer /data/uploads, ikut volume dan perlu ikut dibackup bersama database).
# UPLOAD_DIR=./data/uploads

# Batas ukuran body permintaan (adapter-node). Bawaan 512K terlalu kecil untuk unggah foto (maks. 4 MB);
# image kontainer sudah menyetelnya ke 8M. Batas body reverse proxy juga harus minimal 6 MB.
# BODY_SIZE_LIMIT=8M


# Foto sampul artikel dari Unsplash (opsional). Tanpa kunci, tombol "Cari di Unsplash" tidak muncul dan
# sampul tetap bisa diunggah sendiri. Kunci hanya dipakai di server dan tidak pernah dikirim ke browser.
# Buat aplikasi di https://unsplash.com/developers (mode demo: 50 permintaan/jam), lalu salin "Access Key".
# UNSPLASH_ACCESS_KEY=
# Nama aplikasi yang didaftarkan di Unsplash; dipakai sebagai utm_source pada tautan kredit foto.
# UNSPLASH_APP_NAME=lembang_adventures
# Hanya untuk tes (server Unsplash tiruan). Jangan diisi di produksi.
# UNSPLASH_API_URL=https://api.unsplash.com
